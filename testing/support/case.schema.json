{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "name", "kind", "source", "compile", "basis"],
  "properties": {
    "schema_version": { "const": 2 },
    "name": { "type": "string", "pattern": "^(regression|e2e)\\.[a-z0-9_]+\\.[a-z0-9_]+$" },
    "kind": { "enum": ["compile", "compile_fail", "run", "run_fail", "run_abort"] },
    "source": { "type": "string", "minLength": 1 },
    "basis": { "type": "string", "minLength": 1 },
    "compile": { "$ref": "#/$defs/stage" },
    "run": { "$ref": "#/$defs/run" }
  },
  "allOf": [
    { "if": { "properties": { "kind": { "enum": ["run", "run_fail", "run_abort"] } } },
      "then": { "required": ["run"] }, "else": { "not": { "required": ["run"] } } },
    { "if": { "properties": { "kind": { "const": "compile_fail" } } },
      "then": { "properties": { "compile": { "required": ["stderr"], "properties": { "exit_code": { "const": 1 } } } } },
      "else": { "properties": { "compile": { "properties": { "exit_code": { "const": 0 } } } } } },
    { "if": { "properties": { "kind": { "const": "run_fail" } } },
      "then": { "properties": { "run": { "required": ["failure"], "properties": { "exit_code": { "const": 120 } } } } },
      "else": { "properties": { "run": { "not": { "required": ["failure"] } } } } },
    { "if": { "properties": { "kind": { "const": "run_abort" } } },
      "then": { "properties": { "run": { "properties": { "exit_code": { "const": 121 },
        "stdout": { "const": { "exact": "" } }, "stderr": { "const": { "exact": "" } } } } } } }
  ],
  "$defs": {
    "match": { "oneOf": [
      { "type": "object", "required": ["exact"], "additionalProperties": false, "properties": { "exact": { "type": "string" } } },
      { "type": "object", "required": ["contains"], "additionalProperties": false, "properties": {
        "contains": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } } } }
    ] },
    "stage": {
      "type": "object", "additionalProperties": false, "required": ["exit_code"],
      "properties": {
        "exit_code": { "type": "integer", "minimum": 0, "maximum": 2147483647 },
        "timeout_seconds": { "type": "number", "exclusiveMinimum": 0, "maximum": 30 },
        "stdout": { "$ref": "#/$defs/match" }, "stderr": { "$ref": "#/$defs/match" }
      }
    },
    "run": {
      "type": "object", "additionalProperties": false, "required": ["exit_code"],
      "properties": {
        "exit_code": { "type": "integer", "minimum": 0, "maximum": 2147483647 },
        "timeout_seconds": { "type": "number", "exclusiveMinimum": 0, "maximum": 5 },
        "stdout": { "$ref": "#/$defs/match" }, "stderr": { "$ref": "#/$defs/match" },
        "failure": {
          "type": "object", "additionalProperties": false, "required": ["category", "file", "line", "column"],
          "properties": {
            "category": { "enum": ["Arithmetic.Overflow", "Arithmetic.DivisionByZero", "Arithmetic.ShiftCount",
              "Conversion.OutOfRange", "Conversion.PrecisionLoss", "Conversion.NonFinite", "Conversion.Fractional", "Panic", "Assertion"] },
            "file": { "type": "string", "minLength": 1 },
            "line": { "type": "integer", "minimum": 1 }, "column": { "type": "integer", "minimum": 1 }
          }
        }
      }
    }
  }
}
